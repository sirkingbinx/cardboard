{
  "metadata": [
    {
      "src": [
        {
          "files": [ "**/Cardboard.dll" ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**/*.yml" ]
      },
      {
        "files": [ "articles/**/*.md", "toc.yml", "*.md" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ]
      }
    ],
    "dest": "_site",
    "template": [ "default" ],
    "globalMetadata": {
      "_appTitle": "Cardboard"
    }
  }
}
