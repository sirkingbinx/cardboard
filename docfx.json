{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [ 
            "Cardboard.dll",
            "Cardboard.xml" 
          ],
          "src": "bin"
        }
      ],
      "output": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "images/favicon.ico"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "cardboard",
      "_appTitle": "cardboard",
      "_enableSearch": true,
      "pdf": false,
      "_appLogoPath": ".github/cardboard.png"
    }
  }
}
