{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [ 
            "**/*.csproj" 
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "CI": "TRUE"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      },
      {
        "files": [
          "api/**/*.yml",
          "api/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "files": [ 
          ".github/cardboard.png" 
        ],
        "dot": true
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "cardboard",
      "_appTitle": "cardboard",
      "_enableSearch": true,
      "pdf": false,
      "_appLogoPath": ".github/cardboard.png",
      "_appFaviconPath": ".github/cardboard.png"
    }
  }
}
