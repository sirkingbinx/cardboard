<?xml version="1.0" encoding="utf-8" ?>
<Project>
    <Target Name="CopyToBuild" AfterTargets="Build">
        <Copy SourceFiles="$(TargetPath)" DestinationFiles="..\bin\$(MSBuildProjectName).dll"/>
        <Message Text="$(MSBuildProjectName).dll -> bin\$(MSBuildProjectName).dll" Importance="high"/>

        <Copy SourceFiles="$(TargetPath)" DestinationFiles="..\bin\$(MSBuildProjectName).xml"/>
        <Message Text="$(MSBuildProjectName).dll -> bin\$(MSBuildProjectName).xml" Importance="high"/>
    </Target>

	<Target Name="InstallToBepInEx" AfterTargets="Build" Condition="Exists('$(GamePath)\BepInEx\plugins')">
		<Copy SourceFiles="$(TargetPath)" DestinationFiles="$(GamePath)\BepInEx\plugins\$(SolutionName)\$(MSBuildProjectName).dll"/>
		<Message Text="$(MSBuildProjectName).dll -> BepInEx\plugins\$(SolutionName)\$(MSBuildProjectName).dll" Importance="high"/>
	</Target>
</Project>
